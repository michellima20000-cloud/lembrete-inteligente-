rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny catch-all to prevent unauthorized access
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // User Profile: strictly isolated by userId
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Reminders subcollection: strictly partitioned under the owner's document
      match /reminders/{reminderId} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
